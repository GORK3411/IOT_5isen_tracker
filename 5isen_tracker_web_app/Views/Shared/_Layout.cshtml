@{
    var title = ViewData["Title"] as string;
    var pageTitle = string.IsNullOrWhiteSpace(title) ? "5isen Tracker" : $"{title} - 5isen Tracker";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_5isen_tracker_web_app.styles.css" asp-append-version="true" />
</head>

<body>
<header>
    <nav class="navbar navbar-expand-sm app-navbar mb-4">
        <div class="container">
            <a class="navbar-brand app-brand d-flex align-items-center gap-2"
               asp-area=""
               asp-controller="WaterContainer"
               asp-action="Index">
                <span class="brand-icon">
                    💧
                </span>
                <span class="brand-name">5isen Tracker</span>
                <span class="app-badge ms-2">IoT Water</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain"
                    aria-controls="navMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navMain">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>
</header>

<div class="container pb-4">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container py-3 d-flex justify-content-between align-items-center">
        <span>&copy; 2025 - 5isen Tracker</span>
        <a class="text-muted text-decoration-none" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>

<!-- JS -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
